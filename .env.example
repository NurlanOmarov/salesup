# ── База ──────────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://salesacademy:CHANGE_ME@localhost:5432/salesacademy"

# ── Auth ──────────────────────────────────────────────────────────────────────
AUTH_SECRET="CHANGE_ME_openssl_rand_base64_32"

# ── AI ────────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY="sk-ant-..."
# OpenAI embeddings, text-embedding-3-small, dimensions=1024 — docs/DECISIONS.md D-001
EMBEDDINGS_API_KEY="sk-proj-..."

# ── Видео ─────────────────────────────────────────────────────────────────────
MEDIA_ROOT="/media"                 # путь volume с HLS/VTT/PDF внутри контейнера
STORAGE_DRIVER="fs"                 # fs сейчас | s3 после переезда (D-003)
VIDEO_SIGNING_SECRET="CHANGE_ME"    # HMAC-подпись URL сегментов (userId+path+exp)
VIDEO_KEY_ENC_SECRET="CHANGE_ME"    # шифрование AES-ключей HLS в БД (Lesson.videoAesKeyEnc)
# true только на временном VPS по IP без TLS (cookie без Secure). На домене с HTTPS — false.
AUTH_COOKIE_INSECURE="false"
# S3 — только после миграции на вариант А (docs/MIGRATION.md):
# S3_ENDPOINT="" S3_BUCKET="" S3_ACCESS_KEY="" S3_SECRET_KEY=""

# ── Telegram: уведомления владельцу о новых заявках (docs/TELEGRAM.md) ────────
# Токен выдаёт @BotFather, chat id — @userinfobot (для группы id отрицательный).
# Получателей может быть несколько — id через запятую: "77980353,123456789".
# Пусто → уведомления не шлются, заявка всё равно видна в /admin/leads.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# ── E-mail (пока не используется: уведомления идут в Telegram) ────────────────
# Письма шлёт worker-контейнер (задача email.send), приложению SMTP не нужен.
# Zoho Mail (бесплатный тариф): SMTP только для своего домена, подтверждённого в Zoho;
#   HOST — smtp.zoho.eu (европейский ДЦ) или smtp.zoho.com; порт 465 (SSL) либо 587 (STARTTLS);
#   USER — полный адрес ящика; PASSWORD — app-специфичный пароль из Zoho (при 2FA);
#   SMTP_FROM обязан совпадать с адресом SMTP_USER, иначе Zoho вернёт 553 Relaying disallowed.
#   Лимит бесплатного тарифа — несколько десятков писем в сутки, для заявок хватает.
EMAIL_ENABLED="false"
SMTP_HOST="smtp.zoho.eu"
SMTP_PORT="465"
SMTP_USER="noreply@example.by"
SMTP_PASSWORD=""
SMTP_FROM="ACTIVE SALES <noreply@example.by>"
OWNER_EMAIL="owner@example.kz"
# Куда слать уведомления о новых заявках с сайта
LEADS_NOTIFY_EMAIL="omarov.nb@gmail.com"

# ── Сайт и контакты (публичные, видны в клиенте) ──────────────────────────────
NEXT_PUBLIC_SITE_URL="https://example.kz"
NEXT_PUBLIC_SUPPORT_WHATSAPP="https://wa.me/375XXXXXXXXX"
NEXT_PUBLIC_SUPPORT_TELEGRAM="https://t.me/username"
NEXT_PUBLIC_SUPPORT_PHONE="+375 (XX) XXX-XX-XX"

# ── Будущее (Фаза 2, не заполнять в MVP) ──────────────────────────────────────
# PAYMENT_PROVIDER="" KASPI_API_KEY="" KASPI_MERCHANT_ID=""

# Голосовой ролплей симулятора (STT/TTS через OpenAI). Голос — биометрия (ПДн РК),
# уходит на внешний сервис — отступление от «один сервер». По умолчанию выкл.
VOICE_ENABLED=false
# Отдельный OpenAI-ключ для аудио; если пусто — берётся EMBEDDINGS_API_KEY
OPENAI_API_KEY=

# ─── Магазин WooCommerce на activesales.by (docs/WOO-INTEGRATION.md) ───
# Курсы продаются в магазине на белорусском домене: карту принимает эквайринг
# Альфа-Банка, к нам приходит только факт оплаты заказа.
# Секрет вебхука — тот же, что задан в WP-админке (WooCommerce → Вебхуки).
# Пусто → приём выключен, /api/payments/woo отвечает 503.
WOO_WEBHOOK_SECRET=
WOO_STORE_URL=https://activesales.by
# Ключи Woo REST API с правами «Чтение» — для ночной сверки заказов (05:00).
WOO_CONSUMER_KEY=
WOO_CONSUMER_SECRET=

# ─── Живые сессии с тренером через SABAK (docs/LIVE-SESSIONS-PLAN.md) ───
# Выключено → раздел встреч скрыт и в консоли владельца, и в кабинете компании.
LIVE_SESSIONS_ENABLED=false
SABAK_BASE_URL=https://api.sabak.kz/api/v1
# Целевой доступ — сервисный ключ (docs/SABAK-INTEGRATION-REQUEST.md, задача 1).
SABAK_CLIENT_ID=
SABAK_CLIENT_SECRET=
# Временный доступ до появления ключей: учётка тренера в SABAK.
SABAK_SERVICE_LOGIN=
SABAK_SERVICE_PASSWORD=
