// prisma/schema.prisma — Бизнес-платформа ACTIVE SALES v1.2 «Автопилот / Один сервер»
// Self-hosted PostgreSQL 16 + pgvector на VPS. Деньги в tiyn (1 ₸ = 100 tiyn), Int.
// v1.1: модерация человеком заменена AI-критиком (ValidationStatus), ContentGap вместо
//       «вопросов тренеру», Postgres-очередь Job, фидбек-петля дизлайков.
// v1.2: вход по логину/паролю, учётки создаёт админ (passwordHash, mustChangePassword);
//       онлайн-оплаты в MVP нет — Enrollment.source по умолчанию MANUAL (модели Order/
//       Payment сохранены для будущего платёжного модуля); видео на диске VPS — все медиа
//       адресуются относительным ключом через lib/storage (fs сейчас, s3 после переезда);
//       мультиязычные субтитры SubtitleTrack (RU/KK/EN/UZ).
// v1.2.1 (пре-реализация): + Lesson.videoAesKeyEnc (шифрованный HLS-ключ), + Event (серверная
//       аналитика), + User.subtitleLang, + Review.userId; удалён directUrl (наследие Supabase);
//       embeddings зафиксированы: voyage-3 / vector(1024) — docs/DECISIONS.md.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

// ─────────────────────────── ПОЛЬЗОВАТЕЛИ И АУТЕНТИФИКАЦИЯ ───────────────────────────

enum UserRole {
  STUDENT
  OWNER // владелец платформы: видит консоль, ничего не модерирует
}

model User {
  id                 String        @id @default(cuid())
  // B2B (docs/B2B-PLAN.md §5.1): учётка работника организации создаётся БЕЗ e-mail —
  // платформа не получает ПДн (оферта /offer-b2b, п. 10.1). Поэтому e-mail опционален,
  // а входить можно по login (acme-0042) либо по e-mail. Хотя бы одно из полей задано.
  email              String?       @unique
  login              String?       @unique
  emailVerified      DateTime?
  name               String? // ФИО для сертификата
  phone              String?
  image              String?
  role               UserRole      @default(STUDENT)
  // v1.2: вход по логину/паролю; учётку и временный пароль выдаёт админ
  passwordHash       String? // argon2id
  mustChangePassword Boolean       @default(true)
  // Акцепт оферты и политики ПДн при первом входе: доказательство заключения
  // договора (ст. 408 ГК РБ) и согласия по Закону № 99-З. Версия — LEGAL_VERSION
  // из src/content/legal, чтобы было видно, какую редакцию принял ученик.
  termsAcceptedAt    DateTime?
  termsVersion       String?
  industry           String? // отрасль — для персонализации AI-задач
  position           String?
  locale             String        @default("ru")
  subtitleLang       SubtitleLang? // язык субтитров по умолчанию в плеере (null = выкл)
  deviceLimit        Int? // лимит одновременных устройств: null = стандартный (DEVICE_LIMIT), 0 = безлимит, N = N устройств
  weeklyGoal         Int           @default(3) // учебная цель: сколько уроков завершать в неделю (виджет на дашборде)
  onboardedAt        DateTime? // когда ученик прошёл онбординг-тур кабинета (null = ещё не видел)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  deletedAt          DateTime? // soft delete / анонимизация

  accounts        Account[]
  sessions        Session[]
  devices         Device[]
  enrollments     Enrollment[]
  orders          Order[]
  attempts        QuizAttempt[]
  progress        LessonProgress[]
  notes           Note[]
  certificates    Certificate[]
  aiConversations AiConversation[]
  simulations     SimulationRun[]
  gamification    GamificationProfile?
  badges          UserBadge[]
  contentGaps     ContentGap[]
  aiUsage         AiUsageDay[]
  reviews         Review[]
  events          Event[]
  llmUsage        LlmUsage[]
  cardReviews     CardReview[]
  orgMemberships  OrgMembership[]
  orgKeyWraps     OrgKeyWrap[]
}

// Auth.js v5
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// Антишаринг
model Device {
  id          String   @id @default(cuid())
  userId      String
  fingerprint String
  label       String?
  lastIp      String?
  lastCity    String?
  lastSeenAt  DateTime @default(now())
  isBlocked   Boolean  @default(false)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, fingerprint])
  @@index([userId, lastSeenAt])
}

// ─────────────────────────── ВАЛИДАЦИЯ КОНТЕНТА (AI-КРИТИК) ───────────────────────────

enum ContentOrigin {
  MANUAL // редкий случай: владелец что-то поправил руками
  AI_GENERATED
}

// Заменяет человеческую модерацию. Жизненный цикл: PENDING → критик → VALIDATED (публикация)
// или FAILED → авто-регенерация (regenCount++) → снова критик; после 2 неудач остаётся FAILED
// (не публикуется, попадает в дайджест владельцу как информация).
enum ValidationStatus {
  PENDING
  VALIDATED
  FAILED
}

// ─────────────────────────── КАТАЛОГ ───────────────────────────

enum ProductType {
  COURSE
  TEST
  SURVEY
  BUNDLE
}

enum PublishStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

// Ось витрины «для кого» (D-… см. DECISIONS). EVERYONE — универсальные навыки
// (тайм-менеджмент, базовые продажи), SPECIALIZED — под конкретную отрасль (industry).
// Управляет фильтром на /courses; industry остаётся меткой отрасли для SPECIALIZED.
enum CourseAudience {
  EVERYONE
  SPECIALIZED
}

enum AccessDuration {
  LIFETIME
  MONTHS_1
  MONTHS_3
  MONTHS_6
  MONTHS_12
  MONTHS_24
  MONTHS_36
}

model Course {
  id                  String         @id @default(cuid())
  slug                String         @unique
  type                ProductType    @default(COURSE)
  title               String
  subtitle            String?
  description         String         @db.Text // markdown; генерируется фабрикой из транскриптов
  industry            String?
  audience            CourseAudience @default(SPECIALIZED) // ось витрины «для кого» (фильтр /courses)
  coverUrl            String?
  coverAlt            String? // alt-текст обложки (image SEO/доступность); генерируется AI по картинке
  promoVideoKey       String? // ключ HLS-папки трейлера в lib/storage (публичный, без шифрования)
  priceTiyn           Int
  oldPriceTiyn        Int?
  /// ID товара в WooCommerce на activesales.by. Заполнен → на витрине кнопка
  /// «Купить» ведёт в магазин, а оплаченный заказ открывает доступ автоматически
  /// (docs/WOO-INTEGRATION.md). Пусто → курс продаётся только вручную.
  /// Заказ ищет курс сначала по SKU товара (SKU = slug), это поле — запасной ключ.
  wooProductId        Int?           @unique
  /// Срок доступа, который получает ученик по умолчанию («по тарифу курса» в
  /// админке). Год — базовое решение тарифного плана: материалы остаются у
  /// ученика, а AI-практика тратит токены и не может быть бессрочной
  /// (docs/PRICING-PLAN.md §9). Бессрочный доступ — осознанный выбор в сделке.
  accessDuration      AccessDuration @default(MONTHS_12)
  status              PublishStatus  @default(DRAFT)
  inDevelopment       Boolean        @default(false) // бейдж «В разработке» на витрине (курс виден, но контент ещё не готов)
  sortOrder           Int            @default(0)
  // Фабрика курсов
  sourcePlaylistUrl   String? // YouTube-плейлист — источник курса
  factoryRunAt        DateTime? // когда курс собран/пересобран фабрикой
  // Сертификат
  certificateEnabled  Boolean        @default(true)
  certificateMinScore Int            @default(80)
  hoursLabel          String?
  // SEO (генерируется фабрикой, валидируется критиком; поля *Title/*Description —
  // ручной override владельца поверх фабрики: пусто → берётся сгенерённое/дефолт).
  seoTitle            String?
  seoDescription      String?
  ogImageUrl          String?
  ogTitle             String? // override OG-заголовка (иначе title)
  ogDescription       String? // override OG-описания (иначе subtitle)
  canonicalPath       String? // override canonical (иначе /courses/<slug>)
  focusKeyword        String? // целевой запрос — для AI-скоринга и подсказок
  seoNoindex          Boolean        @default(false) // снять из индекса (напр. черновик-препринт)
  learnPoints         Json? // string[]
  targetAudience      Json? // string[]
  faq                 Json? // {q,a}[]
  publishedAt         DateTime?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  modules      Module[]
  enrollments  Enrollment[]
  translations CourseTranslation[]
  orderItems   OrderItem[]
  certificates Certificate[]
  reviews      Review[]
  quizzes      Quiz[]
  orgLicenses  OrgLicense[]

  @@index([status, type])
}

model Module {
  id        String   @id @default(cuid())
  courseId  String
  title     String
  sortOrder Int      @default(0)
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons   Lesson[]

  @@index([courseId, sortOrder])
}

enum VideoStatus {
  NONE // видео ещё не загружено фабрикой
  READY // HLS на диске VPS (media volume), можно смотреть
}

enum SubtitleLang {
  RU
  KK
  EN
  UZ
}

enum SubtitleOrigin {
  ORIGINAL // из исходного транскрипта (RU)
  TRANSLATED // перевод LLM-ом в фабрике
}

// Дорожки субтитров per-урок. VTT-файлы лежат рядом с HLS (vttKey — относительный ключ
// в lib/storage), выдаются тем же защищённым каналом, что и видео. Переводы проходят
// выборочную проверку AI-критиком.
model SubtitleTrack {
  id         String           @id @default(cuid())
  lessonId   String
  lang       SubtitleLang
  origin     SubtitleOrigin   @default(TRANSLATED)
  vttKey     String // напр. courses/<slug>/lessons/<id>/subs/kk.vtt
  validation ValidationStatus @default(PENDING)
  createdAt  DateTime         @default(now())
  lesson     Lesson           @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([lessonId, lang])
}

model Lesson {
  id               String        @id @default(cuid())
  moduleId         String
  title            String
  description      String?       @db.Text
  sortOrder        Int           @default(0)
  status           PublishStatus @default(DRAFT)
  isFreePreview    Boolean       @default(false)
  // Видео: HLS AES-128, относительный ключ в lib/storage (fs на VPS сейчас, s3 потом)
  videoKey         String? // префикс: courses/<slug>/lessons/<id>/ (master.m3u8, сегменты)
  videoAesKeyEnc   String? // 16-байтовый AES-128-ключ HLS, зашифрованный app-секретом (VIDEO_KEY_ENC_SECRET); отдаётся через /api/video/key/<lessonId>
  videoStatus      VideoStatus   @default(NONE)
  audioKey         String? // аудиоверсия урока: аудиодорожка (m4a), извлечённая фабрикой из видео (factory:audio); ключ в lib/storage
  podcastKey       String? // AI-подкаст: двухголосый обзор-диалог по уроку (NotebookLM Audio Overview, factory:podcast), m4a; ключ в lib/storage
  slidesPdfKey     String? // AI-презентация урока: дизайнерская колода NotebookLM Slide Deck (factory:slides-pdf), pdf; ключ в lib/storage. Доп. материал рядом с типизированной колодой SLIDES
  durationSec      Int?
  youtubeUrl       String? // источник (видео скачивается и кодируется CLI-фабрикой)
  // Прохождение
  requiresQuizPass Boolean       @default(false)
  xpReward         Int           @default(10)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  module              Module               @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  transcript          Transcript?
  quiz                Quiz?
  progress            LessonProgress[]
  notes               Note[]
  attachments         Attachment[]
  aiConversations     AiConversation[]
  simulationScenarios SimulationScenario[]
  contentGaps         ContentGap[]
  aiArtifacts         AiArtifact[]
  subtitles           SubtitleTrack[]

  @@index([moduleId, sortOrder])
}

model Attachment {
  id          String  @id @default(cuid())
  lessonId    String
  title       String
  fileKey     String // относительный ключ в lib/storage
  watermarked Boolean @default(true)
  lesson      Lesson  @relation(fields: [lessonId], references: [id], onDelete: Cascade)
}

// ─────────────────────────── ТРАНСКРИПТЫ / RAG ───────────────────────────

enum TranscriptStatus {
  PENDING
  FETCHED
  CLEANED
  EMBEDDED
  FAILED
}

model Transcript {
  id        String           @id @default(cuid())
  lessonId  String           @unique
  sourceUrl String
  language  String           @default("ru")
  rawText   String?          @db.Text
  cleanText String?          @db.Text // абзацы с таймкодами [mm:ss]
  status    TranscriptStatus @default(PENDING)
  error     String?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  lesson Lesson            @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  chunks TranscriptChunk[]
}

model TranscriptChunk {
  id           String                       @id @default(cuid())
  transcriptId String
  lessonId     String // денормализация для RAG-фильтров
  courseId     String
  seq          Int
  text         String                       @db.Text
  startSec     Int
  endSec       Int
  embedding    Unsupported("vector(1024)")? // voyage-3, 1024 измерения — см. docs/DECISIONS.md D-001
  transcript   Transcript                   @relation(fields: [transcriptId], references: [id], onDelete: Cascade)

  @@index([courseId])
  @@index([lessonId])
}

// ─────────────────────────── ТЕСТЫ / АНКЕТЫ ───────────────────────────

enum QuizKind {
  LESSON_QUIZ
  FINAL_EXAM
  STANDALONE
  SURVEY
}

enum QuestionType {
  SINGLE_CHOICE
  MULTI_CHOICE
  TRUE_FALSE
  ORDERING
  FILL_BLANK
  MATCHING // сопоставить пары: левый элемент ↔ правый (option.text ↔ option.pairKey)
  CATEGORIZATION // распределить элементы по категориям (option.text → option.pairKey)
  PRACTICE // упражнение «составьте сами»: свободный ввод + эталон и критерии для самопроверки
  SCENARIO // диалог: реплика клиента/врача → выбор лучшего ответа (один верный) + разбор
  OPEN_TEXT // проверяет LLM по rubric; фоллбэк — повтор более сильной моделью (НЕ человек)
  SCALE
}

model Quiz {
  id           String        @id @default(cuid())
  kind         QuizKind      @default(LESSON_QUIZ)
  lessonId     String?       @unique
  courseId     String?
  title        String
  description  String?
  passScore    Int           @default(80)
  maxAttempts  Int?
  timeLimitSec Int?
  shuffle      Boolean       @default(true)
  status       PublishStatus @default(DRAFT)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  lesson    Lesson?       @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  course    Course?       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  questions Question[]
  attempts  QuizAttempt[]
}

model Question {
  id          String           @id @default(cuid())
  quizId      String
  type        QuestionType
  text        String           @db.Text
  explanation String?          @db.Text // разбор с цитатой урока и таймкодом
  points      Int              @default(1)
  sortOrder   Int              @default(0)
  rubric      Json? // OPEN_TEXT: [{criterion, weight}]
  origin      ContentOrigin    @default(AI_GENERATED)
  // AI-критик (вместо модерации человеком)
  validation  ValidationStatus @default(PENDING)
  criticScore Int? // 0–100 от критика
  criticNotes String?          @db.Text
  regenCount  Int              @default(0) // авто-регенераций после FAILED / дизлайков
  thumbsDown  Int              @default(0) // фидбек учеников; ≥2 → авто-регенерация (Job)
  validatedAt DateTime?

  quiz    Quiz             @relation(fields: [quizId], references: [id], onDelete: Cascade)
  options QuestionOption[]
  answers AttemptAnswer[]

  @@index([quizId, sortOrder])
  @@index([validation])
}

model QuestionOption {
  id         String   @id @default(cuid())
  text       String
  isCorrect  Boolean  @default(false)
  sortOrder  Int      @default(0) // для ORDERING — правильная позиция
  // MATCHING — правый элемент пары (text = левый); CATEGORIZATION — правильная категория
  pairKey    String?
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
}

enum AttemptStatus {
  IN_PROGRESS
  PASSED
  FAILED
  SUBMITTED
}

model QuizAttempt {
  id         String        @id @default(cuid())
  quizId     String
  userId     String
  status     AttemptStatus @default(IN_PROGRESS)
  scorePct   Int?
  startedAt  DateTime      @default(now())
  finishedAt DateTime?

  quiz    Quiz            @relation(fields: [quizId], references: [id], onDelete: Cascade)
  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  answers AttemptAnswer[]

  @@index([userId, quizId])
}

model AttemptAnswer {
  id            String      @id @default(cuid())
  attemptId     String
  questionId    String
  payload       Json
  isCorrect     Boolean?
  pointsAwarded Int         @default(0)
  aiFeedback    String?     @db.Text
  attempt       QuizAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question      Question    @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([attemptId, questionId])
}

// ─────────────────────────── ДОСТУПЫ / ЗАКАЗЫ / ПЛАТЕЖИ ───────────────────────────
// v1.2: в MVP онлайн-оплаты НЕТ — Order/Payment/PromoCode/WebhookEvent сохранены в схеме
// под будущий платёжный модуль (Kaspi/Freedom Pay, Фаза 2+) и для ручных заказов-записей.

enum EnrollmentSource {
  PURCHASE
  MANUAL
  FREE
  B2B // место из корпоративной лицензии (OrgLicense)
}

model Enrollment {
  id            String           @id @default(cuid())
  userId        String
  courseId      String
  source        EnrollmentSource @default(MANUAL) // v1.2: доступ выдаёт админ после устной оплаты
  orderId       String?
  // B2B: из какой лицензии выдано место. Занятые места считаются как
  // count(Enrollment where licenseId = X and revokedAt is null) — отдельного
  // счётчика нет, чтобы нечему было рассинхронизироваться.
  licenseId     String?
  startsAt      DateTime         @default(now())
  expiresAt     DateTime?
  revokedAt     DateTime?
  /// Почему место отозвано: 'manual' — решением человека (владелец/ответственный
  /// представитель), 'org_suspended' — заморозка организации, 'member_inactive' —
  /// работник деактивирован. Нужно, чтобы возобновление организации вернуло только
  /// автоматически снятые доступы и не воскресило отозванные вручную.
  /// lib/access.ts это поле НЕ читает — доступ по-прежнему решает revokedAt.
  revokedReason String?
  /// Домен/рынок (SiteHost.code: "BY"|"KZ"|"RU"), к которому относится доступ —
  /// выбирает админ явно при выдаче (см. lib/seo/site-hosts.ts). Взять из сессии
  /// нельзя: сессия админа не привязана к рынку студента. null — доступ выдан
  /// до внедрения разметки по доменам (docs/MULTI-DOMAIN-PLAN.md).
  site          String?
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  course        Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  license       OrgLicense?      @relation(fields: [licenseId], references: [id], onDelete: SetNull)

  @@unique([userId, courseId])
  @@index([courseId])
  @@index([licenseId])
  @@index([site, startsAt])
}

enum OrderStatus {
  PENDING
  PAID
  CANCELED
  REFUNDED
}

enum PaymentProvider {
  KASPI
  FREEDOMPAY
  HALYK
  MANUAL
  MOCK
  // Магазин WooCommerce на activesales.by: карту принимает эквайринг Альфа-Банка,
  // к нам приходит только факт оплаты заказа (docs/WOO-INTEGRATION.md).
  WOOCOMMERCE
}

model Order {
  id           String      @id @default(cuid())
  number       String      @unique // AS-2026-000123
  userId       String
  email        String
  status       OrderStatus @default(PENDING)
  subtotalTiyn Int
  discountTiyn Int         @default(0)
  totalTiyn    Int
  promoCodeId  String?
  createdAt    DateTime    @default(now())
  paidAt       DateTime?

  user      User        @relation(fields: [userId], references: [id])
  items     OrderItem[]
  payments  Payment[]
  promoCode PromoCode?  @relation(fields: [promoCodeId], references: [id])

  @@index([userId, status])
}

model OrderItem {
  id        String @id @default(cuid())
  orderId   String
  courseId  String
  priceTiyn Int
  order     Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  course    Course @relation(fields: [courseId], references: [id])
}

enum PaymentStatus {
  CREATED
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

model Payment {
  id                String          @id @default(cuid())
  orderId           String
  provider          PaymentProvider
  providerPaymentId String?
  status            PaymentStatus   @default(CREATED)
  amountTiyn        Int
  payload           Json?
  receiptUrl        String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  order             Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([provider, providerPaymentId])
  @@index([orderId])
}

model WebhookEvent {
  id              String    @id @default(cuid())
  provider        String
  providerEventId String
  payload         Json
  processedAt     DateTime?
  error           String?
  receivedAt      DateTime  @default(now())

  @@unique([provider, providerEventId])
}

model PromoCode {
  id            String    @id @default(cuid())
  code          String    @unique
  percentOff    Int?
  amountOffTiyn Int?
  maxUses       Int?
  usedCount     Int       @default(0)
  validFrom     DateTime?
  validUntil    DateTime?
  isActive      Boolean   @default(true)
  orders        Order[]
}

// Отзывы: модерирует LLM (токсичность/спам/релевантность), не человек
model Review {
  id             String           @id @default(cuid())
  courseId       String
  userId         String? // автор-ученик; null — отзыв внесён владельцем (например, с живых тренингов)
  userName       String
  rating         Int // 1–5
  text           String           @db.Text
  autoModeration ValidationStatus @default(PENDING) // VALIDATED → виден публично
  moderationNote String?
  createdAt      DateTime         @default(now())
  course         Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user           User?            @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([courseId, autoModeration])
}

/// Перевод карточки курса на язык витрины (казахский, узбекский).
/// Видео и материалы курса остаются русскими — переводим только то, что читает
/// посетитель на витрине: название, подзаголовок, описание и SEO-поля. На самой
/// карточке при этом явно написано, на каком языке курс и какие есть субтитры,
/// чтобы перевод названия не создавал ложного ожидания.
///
/// Тексты переносит фабрика (scripts/factory/course-i18n.ts): по умолчанию через
/// экспорт → перевод оператором → импорт, с флагом --api — через Haiku.
model CourseTranslation {
  id             String   @id @default(cuid())
  courseId       String
  /// Код языка витрины: "kk" | "uz" (русский живёт в самой модели Course).
  locale         String
  title          String
  subtitle       String?
  description    String?  @db.Text
  seoTitle       String?
  seoDescription String?
  updatedAt      DateTime @updatedAt
  course         Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([courseId, locale])
  @@index([locale])
}

/// Отзыв с внешней площадки (Яндекс/Google Карты), перенесённый владельцем вручную.
/// Автопарсинг карт не делаем: он нарушает условия площадок и ломается при смене
/// вёрстки — тексты переносит владелец, указывая автора и ссылку на первоисточник,
/// чтобы читатель мог проверить отзыв там же.
model ExternalReview {
  id        String       @id @default(cuid())
  source    ReviewSource
  author    String
  text      String       @db.Text
  /// 1–5, как на площадке. Пусто — если в источнике оценки не видно: выдумывать
  /// звёзды нельзя, отзыв тогда показывается без цифры.
  rating    Int?
  /// Ссылка на карточку организации с этим отзывом (проверяемость).
  url       String?
  sortOrder Int          @default(0)
  published Boolean      @default(true)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([published, sortOrder])
}

enum ReviewSource {
  YANDEX
  GOOGLE
  OTHER
}

// ─────────────────────────── ПРОГРЕСС / ЗАМЕТКИ / СЕРТИФИКАТЫ ───────────────────────────

model LessonProgress {
  id              String    @id @default(cuid())
  userId          String
  lessonId        String
  watchedSec      Int       @default(0)
  lastPositionSec Int       @default(0)
  completedAt     DateTime?
  updatedAt       DateTime  @updatedAt
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson          Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
}

model Note {
  id          String   @id @default(cuid())
  userId      String
  lessonId    String
  timecodeSec Int
  text        String   @db.Text
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson      Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@index([userId, lessonId])
}

// Минимизация ПДн (правило 9): именной сертификат НЕ формируется автоматически и ФИО
// в системе НЕ хранится. При выполнении условий создаётся запись со статусом READY
// («готов к выдаче»); ученику показывается инструкция отправить ФИО на почту, админ
// изготавливает документ вне системы и вручную помечает ISSUED. Поля holderName/number/
// verifyHash/pdfKey остаются опциональными на случай ручного заполнения владельцем.
enum CertificateStatus {
  READY // ученик выполнил условия, готов получить сертификат
  ISSUED // владелец выдал сертификат вручную
}

model Certificate {
  id         String            @id @default(cuid())
  number     String?           @unique // присваивается вручную при выдаче
  userId     String
  courseId   String
  holderName String? // НЕ заполняется автоматически (ПДн); опц. ручной ввод владельцем
  scorePct   Int?
  hoursLabel String?
  pdfKey     String? // относительный ключ в lib/storage (если владелец приложит PDF)
  verifyHash String?           @unique
  status     CertificateStatus @default(READY)
  readyAt    DateTime          @default(now()) // когда выполнены условия
  issuedAt   DateTime? // когда владелец пометил «Выдан»
  revokedAt  DateTime?
  user       User              @relation(fields: [userId], references: [id])
  course     Course            @relation(fields: [courseId], references: [id])

  @@unique([userId, courseId])
}

// ─────────────────────────── AI: ЧАТ / СИМУЛЯЦИИ / АРТЕФАКТЫ / ЛИМИТЫ ───────────────────────────

model AiConversation {
  id        String      @id @default(cuid())
  userId    String
  lessonId  String
  createdAt DateTime    @default(now())
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson    Lesson      @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  messages  AiMessage[]

  @@index([userId, lessonId])
}

enum AiRole {
  USER
  ASSISTANT
}

model AiMessage {
  id             String         @id @default(cuid())
  conversationId String
  role           AiRole
  content        String         @db.Text
  citedChunkIds  Json?
  thumbsDown     Boolean        @default(false) // фидбек-петля
  inputTokens    Int?
  outputTokens   Int?
  createdAt      DateTime       @default(now())
  conversation   AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

// Тип ЛПР в тренажёре-симуляторе — устойчивый характер собеседника
enum PersonaArchetype {
  BUSY_DOCTOR // занятой врач: мало времени, перебивает
  SKEPTIC // скептик-завотделением: требует доказательств
  PROCUREMENT // закупщик: давит на цену/условия
  FRIENDLY_NONCOMMITTAL // дружелюбный, но не назначает
  AGGRESSIVE // негативный/закрытый
}

model SimulationScenario {
  id              String           @id @default(cuid())
  lessonId        String
  title           String
  persona         String           @db.Text
  objectives      Json
  archetype       PersonaArchetype @default(BUSY_DOCTOR) // тип ЛПР (поведение клиента)
  difficulty      Int              @default(2) // 1..3 — насколько упирается клиент
  complianceRules Json? // string[]: запрещённые/обязательные формулировки для проверки
  rubric          Json? // PhaseSpec[] | null → дефолтная рубрика фаз визита
  origin          ContentOrigin    @default(AI_GENERATED)
  validation      ValidationStatus @default(PENDING) // публикуется после AI-критика
  criticScore     Int?
  regenCount      Int              @default(0)
  thumbsDown      Int              @default(0)
  lesson          Lesson           @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  runs            SimulationRun[]

  @@index([lessonId, validation])
}

model SimulationRun {
  id              String             @id @default(cuid())
  scenarioId      String
  userId          String
  dialog          Json
  debrief         String?            @db.Text
  scorePct        Int?
  scorecard       Json? // Scorecard: разбивка по фазам визита
  complianceFlags Json? // ComplianceFlag[]: нарушения требований
  passed          Boolean? // false при любом fail-флаге (compliance instant-fail)
  finishedAt      DateTime?
  createdAt       DateTime           @default(now())
  scenario        SimulationScenario @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum AiArtifactType {
  SUMMARY
  CHECKLIST // JSON-чек-лист подготовки (интерактивные пункты с локальным прогрессом)
  FLASHCARDS // JSON-набор карточек «термин → определение» (тренажёр запоминания)
  BLOG_DRAFT
  SLIDES // JSON-колода слайдов презентации урока (рендерится просмотрщиком)
  OBJECTIONS // JSON-тренажёр отработки возражений клиента (интерактивный выбор ответа)
  SCRIPT_BUILDER // JSON-конструктор скрипта: собрать этапы звонка в правильном порядке
  DIALOGUE_AUDIT // JSON-тренажёр «найди ошибку»: отметить неверные реплики менеджера
  HOTSPOT // JSON-схема с кликабельными точками на изображении (этапы/зоны)
  BRANCHING // JSON-дерево ветвящегося диалога: выбор реплики ведёт к разным исходам
  TASK_METAPHOR // JSON-тренажёр-метафора (слон/лягушка/гвозди): ученик вводит свои задачи, анимированный SVG реагирует
  EISENHOWER // JSON-интерактив «матрица Эйзенхауэра»: ученик раскладывает задачи по 4 квадрантам важно×срочно
  RULE_6040 // JSON-интерактив «правило 60/40»: кольцо дня, планируем ≤60%, срочное влезает в буфер
  SMART_GOAL // JSON-интерактив «SMART-цель»: 5 критериев собирают мишень
  TIME_AUDIT // JSON-интерактив «хронометраж/пожиратели времени»: круг дня, экстраполяция потерь
  CLIENT_TYPES // JSON-тренажёр типологии клиента: реплика → тип (зелёный/синий/красный/жёлтый) → эффективная реакция
}

model AiArtifact {
  id          String           @id @default(cuid())
  lessonId    String
  type        AiArtifactType
  content     String           @db.Text
  validation  ValidationStatus @default(PENDING)
  criticScore Int?
  regenCount  Int              @default(0)
  thumbsDown  Int              @default(0)
  createdAt   DateTime         @default(now())
  lesson      Lesson           @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  cardReviews CardReview[]

  @@unique([lessonId, type])
}

// Прогресс интервального повторения флеш-карточки (Leitner-lite, по карточке на ученика).
// Карточка адресуется парой (artifactId FLASHCARDS, cardIndex в deck.cards). Тренажёр
// не использует LLM — повторение чистой механикой по dueAt (CLAUDE.md: один сервер).
model CardReview {
  id             String     @id @default(cuid())
  userId         String
  artifactId     String
  cardIndex      Int // индекс карточки в FlashcardsData.cards
  box            Int        @default(0) // ступень Leitner: 0 — новая/проваленная
  dueAt          DateTime   @default(now())
  repetitions    Int        @default(0)
  lapses         Int        @default(0)
  lastResult     Boolean? // последний ответ: запомнил/нет
  lastReviewedAt DateTime? // когда карточку последний раз повторяли (для дневных целей)
  createdAt      DateTime   @default(now())
  user           User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  artifact       AiArtifact @relation(fields: [artifactId], references: [id], onDelete: Cascade)

  @@unique([userId, artifactId, cardIndex])
  @@index([userId, dueAt])
}

model AiUsageDay {
  id            String   @id @default(cuid())
  userId        String
  day           DateTime @db.Date
  chatMessages  Int      @default(0)
  openChecks    Int      @default(0)
  simulations   Int      @default(0)
  tokensIn      Int      @default(0)
  tokensOut     Int      @default(0)
  voiceSttSec   Int      @default(0) // секунды распознавания речи (Whisper) за день
  voiceTtsChars Int      @default(0) // символы озвучки (TTS) за день
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, day])
}

// Лог каждого LLM-вызова — источник истины для учёта расходов в админке.
// userId = null для системных/фабричных вызовов (генерация курса, переводы, критик),
// заполнен для per-ученик операций (AI-наставник, проверка OPEN_TEXT). Стоимость
// фиксируется при записи по тарифу (lib/ai/pricing) в microUSD (1 USD = 1e6), Int —
// чтобы не плодить ошибки округления (как деньги в tiyn).
model LlmUsage {
  id           String   @id @default(cuid())
  model        String // напр. claude-haiku-4-5, voyage-3
  operation    String // chat | critic | translate | generate | embed | open_check | ...
  userId       String? // null = системный/фабричный вызов
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)
  costMicroUsd Int      @default(0)
  createdAt    DateTime @default(now())
  user         User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([createdAt])
  @@index([model])
}

// Журнал «пробелов контента»: вопросы учеников, на которые RAG не нашёл ответа в материалах.
// AI честно отвечает «в курсе это не раскрывается» + предлагает ближайший урок; сюда пишется лог.
// Агрегируется в еженедельный дайджест владельцу как идеи для новых уроков. Никто не обязан отвечать.
model ContentGap {
  id        String   @id @default(cuid())
  userId    String?
  lessonId  String?
  question  String   @db.Text
  ragScore  Float? // максимальная релевантность найденных чанков
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  lesson    Lesson?  @relation(fields: [lessonId], references: [id], onDelete: SetNull)

  @@index([createdAt])
}

// ─────────────────────────── ОЧЕРЕДЬ ЗАДАЧ (Postgres, без Redis) ───────────────────────────

enum JobStatus {
  QUEUED
  RUNNING
  DONE
  FAILED
}

// Лёгкие фоновые задачи (письма, PDF-сертификат, регенерация вопроса, авто-модерация отзыва,
// дайджест). Обработчик — worker-контейнер (tsx-цикл + node-cron), берёт пачку
// (SELECT ... FOR UPDATE SKIP LOCKED). Тяжёлые медиа-задачи — НЕ сюда, а в CLI-фабрику.
model Job {
  id          String    @id @default(cuid())
  type        String // 'email.send' | 'certificate.generate' | 'question.regen' | 'review.moderate' | 'digest.weekly' | ...
  payload     Json
  status      JobStatus @default(QUEUED)
  runAfter    DateTime  @default(now()) // отложенные задачи
  attempts    Int       @default(0)
  maxAttempts Int       @default(3)
  lastError   String?
  createdAt   DateTime  @default(now())
  finishedAt  DateTime?

  @@index([status, runAfter])
}

// ─────────────────────────── B2B: ОРГАНИЗАЦИИ, ЛИЦЕНЗИИ, МЕСТА ───────────────────────────
// docs/B2B-PLAN.md + публичная оферта для организаций (src/content/legal/offer-b2b.ts).
// Терминология совпадает с офертой: Место = Enrollment из Лицензии, Условное
// обозначение = User.login, Ответственный представитель = OrgMembership.role ORG_ADMIN.
//
// ГЛАВНОЕ: доступ к контенту по-прежнему определяется ТОЛЬКО Enrollment (правило 1
// CLAUDE.md). Организации и лицензии — слой ВЫДАЧИ, порождающий обычные Enrollment;
// lib/access.ts об организациях не знает. Заморозка организации и истечение лицензии
// проставляют Enrollment.revokedAt джобом org.sync-access, а не создают вторую ветку
// проверки доступа.

enum OrgStatus {
  ACTIVE
  SUSPENDED // просрочена оплата (оферта B2B, п. 5.5) — доступы работников отозваны
  ARCHIVED
}

enum OrgRole {
  ORG_ADMIN // «Ответственный представитель»: кабинет организации, места, отчёты
  ORG_LEARNER // работник-ученик
}

/// Клиент-организация. Реквизиты юрлица персональными данными не являются;
/// единственная ПДн-точка — контакты ответственного представителя (оферта, п. 10.7).
model Organization {
  id           String    @id @default(cuid())
  slug         String    @unique // короткий код: acme → логины работников acme-0042
  name         String // наименование клиента
  unp          String? // УНП (для счёта); не ПДн — реквизит юрлица
  contactEmail String? // e-mail ответственного представителя
  contactNote  String? // Telegram/телефон — как удобно клиенту
  note         String?   @db.Text // заметки владельца (номер счёта, договорённости)
  status       OrgStatus @default(ACTIVE)
  /// Счётчик выданных логинов: acme-0001, acme-0002… Инкрементируется в транзакции
  /// самозаписи — гарантирует уникальность без гонок.
  loginSeq     Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  memberships OrgMembership[]
  licenses    OrgLicense[]
  groups      OrgGroup[]
  invites     OrgInvite[]
  keyWraps    OrgKeyWrap[]

  @@index([status])
}

/// Подразделение/филиал — ось группировки отчётности (оферта, п. 8.1). Название
/// вносит клиент; по п. 6 Приложения 1 он обязуется не помещать сюда ФИО.
model OrgGroup {
  id    String @id @default(cuid())
  orgId String
  name  String

  org         Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  memberships OrgMembership[]

  @@unique([orgId, name])
}

/// Членство в организации. Открытым текстом хранится только платформенный код
/// (User.login). Кто за ним стоит — знает клиент; на платформе это лежит лишь
/// в labelEnc, зашифрованном в браузере ключом организации (docs/B2B-PLAN.md §5.2).
model OrgMembership {
  id       String  @id @default(cuid())
  orgId    String
  userId   String
  role     OrgRole @default(ORG_LEARNER)
  groupId  String?
  /// Условное обозначение работника, зашифрованное на клиенте (AES-GCM под ключом
  /// организации). Сервер хранит непрозрачный blob и не может его прочитать.
  labelEnc String?
  isActive Boolean @default(true)

  joinedAt      DateTime  @default(now())
  deactivatedAt DateTime?

  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user  User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  group OrgGroup?    @relation(fields: [groupId], references: [id], onDelete: SetNull)

  @@unique([orgId, userId])
  @@index([orgId, isActive])
}

/// Обёртка ключа организации (L2). Случайный AES-256 ключ существует только в
/// браузере; на сервере лежат его копии, зашифрованные под парольной фразой каждого
/// ORG_ADMIN и под recovery-кодом. Ни ключ, ни фраза на сервер не передаются.
model OrgKeyWrap {
  id         String   @id @default(cuid())
  orgId      String
  userId     String? // владелец обёртки; null — обёртка под recovery-код
  kind       String // 'admin' | 'recovery'
  wrappedKey String // base64(AES-GCM(orgKey)) — iv включён в blob
  kdfSalt    String // base64
  kdfParams  Json // { alg: 'PBKDF2-SHA256', hash: 'SHA-256', iterations: 600000 }
  createdAt  DateTime @default(now())

  org  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user User?        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([orgId, userId, kind])
  @@index([orgId])
}

/// Лицензия = ОДИН курс × N мест × срок (единица лицензии — курс×человек).
/// Работник, которому открыли 3 курса, занимает по одному месту в трёх лицензиях.
model OrgLicense {
  id             String         @id @default(cuid())
  orgId          String
  courseId       String
  seatsTotal     Int
  accessDuration AccessDuration @default(MONTHS_12) // срок доступа одного места
  startsAt       DateTime       @default(now())
  /// Общий дедлайн лицензии: если задан, доступ места не может пережить его
  /// (оферта, п. 4.5 — по истечении срока доступ прекращается автоматически).
  expiresAt      DateTime?
  priceTiyn      Int? // цена места по счёту — для аналитики выручки
  note           String? // номер счёта/договорённость
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  org         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  course      Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  enrollments Enrollment[]

  @@unique([orgId, courseId])
  @@index([orgId])
}

/// Код самозаписи: работник вводит его на /join и создаёт себе анонимную учётку.
/// Коды раздаёт клиент вне платформы (оферта, п. 4.2) — мы не знаем, кому именно.
model OrgInvite {
  id         String    @id @default(cuid())
  orgId      String
  code       String    @unique // 8 символов без похожих букв (0/O, 1/I)
  groupId    String?
  licenseIds Json // string[]: какие лицензии выдать при активации
  maxUses    Int       @default(1)
  usedCount  Int       @default(0)
  expiresAt  DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  createdBy  String? // userId ORG_ADMIN либо OWNER

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, revokedAt])
}

// ─────────────────────────── ЗАЯВКИ / АДМИН-ЖУРНАЛ / БЕЗОПАСНОСТЬ (v1.2) ───────────────────────────

enum LeadStatus {
  NEW
  CONTACTED
  PAID // устно подтверждена оплата → кнопка «создать ученика»
  DECLINED
}

// Тип заявки: розничный ученик или организация. Без него корпоративные заявки
// тонут в общем списке и различаются только по тексту сообщения.
enum LeadKind {
  B2C
  B2B
}

/// Что именно выбрал человек перед отправкой заявки: конкретный курс (розница),
/// подписку на всю библиотеку или набор курсов (корпоративный калькулятор).
/// Без этого менеджер не знает, какую цену собеседник уже видел на экране.
/// Формат обучения, которым интересуется клиент. Офлайн — живой корпоративный
/// тренинг: платформа его не продаёт и не считает, поэтому такие заявки идут без
/// тарифа и расчёта, а в админке по ним нет действий по выдаче доступов.
enum LeadFormat {
  ONLINE
  OFFLINE
}

enum LeadPlan {
  COURSE
  LIBRARY
  COURSES
}

// Заявка с лендинга/страницы курса (в MVP заменяет онлайн-чекаут)
model Lead {
  id                String     @id @default(cuid())
  name              String?
  contact           String // телефон / e-mail / @username — как оставил человек
  courseId          String?
  message           String?    @db.Text
  kind              LeadKind   @default(B2C)
  format            LeadFormat @default(ONLINE)
  /// Сколько сотрудников хочет обучать — только для B2B: по нему сразу видно
  /// уровень корпоративной сетки скидок (docs/PRICING-PLAN.md §8).
  seatsWanted       Int?
  company           String? // наименование организации, если оставили
  /// Выбранный тариф и цена, которую человек видел на экране в момент отправки.
  /// Считает сервер по lib/pricing (клиенту здесь верить нельзя), чтобы цифра в
  /// уведомлении и в счёте совпадала с калькулятором.
  plan              LeadPlan?
  quotedPerSeatTiyn Int? // цена одного места со скидкой, только B2B
  quotedTotalTiyn   Int? // итог: чек за все места (B2B) или цена курса (B2C)
  status            LeadStatus @default(NEW)
  comment           String?    @db.Text // заметки владельца
  // Отметка о согласии на обработку ПДн в форме заявки (Закон № 99-З, ст. 5):
  // момент и версия редакции политики. IP/user-agent не храним (правило 9).
  consentAt         DateTime?
  consentVersion    String?
  /// Домен/рынок (SiteHost.code: "BY"|"KZ"|"RU"), с которого отправлена заявка —
  /// определяется автоматически по Host запроса (lib/seo/site.ts currentSite()).
  /// null — заявка до внедрения разметки по доменам.
  site              String?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  @@index([status, createdAt])
  @@index([site, createdAt])
}

// Журнал действий владельца: каждая выдача/отзыв доступа, сброс пароля, возврат
model AdminLog {
  id           String   @id @default(cuid())
  actorId      String // userId владельца
  action       String // 'student.create' | 'enrollment.grant' | 'enrollment.revoke' | 'password.reset' | ...
  targetUserId String?
  meta         Json?
  createdAt    DateTime @default(now())

  @@index([createdAt])
}

// Защита от перебора паролей (вместо Redis)
model LoginAttempt {
  id        String   @id @default(cuid())
  email     String
  ip        String
  success   Boolean
  createdAt DateTime @default(now())

  @@index([email, createdAt])
  @@index([ip, createdAt])
}

// ─────────────────────────── АНАЛИТИКА (серверные события) ───────────────────────────

// Серверный лог продуктовых событий (PostHog-совместимая структура) — источник истины для
// дайджеста и админ-аналитики: просмотры уроков, сдачи тестов, heatmap досмотров и т.п.
// Внешние счётчики (GA4/Метрика) — только маркетинговый слой на публичных страницах (D-002).
// ПДн не пишем (правило 9 CLAUDE.md); при удалении пользователя события анонимизируются (SetNull).
model Event {
  id        String   @id @default(cuid())
  userId    String?
  name      String // 'lesson.view' | 'video.progress' | 'quiz.submit' | 'lead.create' | ...
  meta      Json? // courseId, lessonId, позиция в секундах и т.п. — без ПДн
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([name, createdAt])
  @@index([userId, createdAt])
}

// ─────────────────────────── ГЕЙМИФИКАЦИЯ ───────────────────────────

model GamificationProfile {
  id            String    @id @default(cuid())
  userId        String    @unique
  xp            Int       @default(0)
  level         Int       @default(1)
  streakDays    Int       @default(0)
  streakFreezes Int       @default(1) // запас «заморозок» серии (спасает пропущенный день)
  lastActiveOn  DateTime? @db.Date
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Badge {
  id          String      @id @default(cuid())
  code        String      @unique
  title       String
  description String
  iconUrl     String?
  users       UserBadge[]
}

model UserBadge {
  userId   String
  badgeId  String
  earnedAt DateTime @default(now())
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge    Badge    @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  @@id([userId, badgeId])
}

/// Глобальные SEO-настройки сайта (singleton: одна строка, id = "singleton").
/// Выносит из кода то, что владелец меняет без деплоя: шаблоны метаданных, соцпрофили
/// (→ sameAs в Organization), подтверждение прав в Search Console / Вебмастере и
/// опциональные маркетинговые счётчики. Счётчики вставляются ТОЛЬКО на публичных
/// (marketing)-страницах — не в кабинете ученика (CLAUDE.md D-002 + правило 9 о ПДн).
model SeoSettings {
  id String @id @default("singleton")

  // Шаблоны метаданных. titleTemplate — паттерн Next ("%s · ACTIVE SALES").
  titleTemplate      String @default("%s · ACTIVE SALES")
  defaultTitle       String @default("Бизнес-платформа ACTIVE SALES — курсы по продажам с AI-наставником")
  defaultDescription String @default("Онлайн-курсы по техникам продаж: видеоуроки, AI-тренажёр на материале тренера, тесты и сертификаты.")

  // Соцпрофили → sameAs + contactPoint в EducationalOrganization JSON-LD.
  socialInstagram String?
  socialTelegram  String?
  socialYoutube   String?
  socialTiktok    String?
  socialFacebook  String?
  socialLinkedin  String?
  socialVk        String?

  /// Рейтинг на внешних площадках — блок доверия на лендинге. Значения владелец
  /// проставляет вручную (у карт нет бесплатного API): пусто → блок скрыт, чтобы
  /// на витрине никогда не появилась выдуманная оценка.
  yandexMapsUrl String?
  yandexRating  Float?
  yandexReviews Int?
  googleMapsUrl String?
  googleRating  Float?
  googleReviews Int?

  // Дефолтная OG-картинка (относительный ключ lib/storage). Пусто → авто-opengraph-image.
  defaultOgKey String?

  // Подтверждение прав (значение content= мета-тега). Публичные страницы, <head>.
  googleVerification String?
  yandexVerification String?

  // Маркетинговые счётчики (D-002): вставляются ТОЛЬКО на (marketing). Пусто → выключено.
  ga4Id           String? // "G-XXXXXXX"
  yandexMetricaId String? // числовой id счётчика Метрики

  // Данные организации → EducationalOrganization JSON-LD (Knowledge Panel).
  orgName        String  @default("Бизнес-платформа ACTIVE SALES")
  orgDescription String? // пусто → defaultDescription
  orgCountry     String  @default("Belarus") // areaServed (англ. название страны)

  // Контакты поддержки: футер, лендинг, «забыли пароль», кабинет ученика, JSON-LD.
  // Правятся в /admin/seo без деплоя; env NEXT_PUBLIC_SUPPORT_* больше не источник.
  orgPhone        String @default("+375 (29) 605-30-32")
  supportWhatsapp String @default("https://wa.me/375296053032") // ссылка wa.me

  updatedAt DateTime @updatedAt
}

/// Переопределения SeoSettings для конкретного домена или языка (мультидомен, D-013).
/// Все поля необязательные: пустое наследуется от глобальных настроек, заполненное
/// перекрывает их. Отдельные коды подтверждения прав обязательны — Search Console и
/// Яндекс.Вебмастер выдают свой токен на каждый ресурс.
model SeoScopeOverride {
  id    String @id @default(cuid())
  /// "BY" | "KZ" | "RU" | "KZ-kk" — см. lib/seo/scope.ts
  scope String @unique

  titleTemplate      String?
  defaultTitle       String?
  defaultDescription String?
  defaultOgKey       String?

  googleVerification String?
  yandexVerification String?
  ga4Id              String?
  yandexMetricaId    String?

  orgDescription  String?
  orgCountry      String?
  orgPhone        String?
  supportWhatsapp String?
  socialTelegram  String?

  updatedAt DateTime @updatedAt
}

/// Метаданные статических публичных страниц из админки (каталог, оферта, политика).
/// path — известный маршрут ("/courses" | "/offer" | "/privacy"). Пустые title/description
/// → фолбэк на захардкоженные в странице. body (markdown) — текст thin-страниц
/// (оферта/политика): пусто → заглушка «текст будет добавлен» и noindex по умолчанию.
///
/// scope — домен и язык, для которых действует запись (мультидомен, D-013):
/// "global" (все домены), "KZ", "RU", "BY" либо "KZ-kk" для казахской версии.
/// Резолв идёт по цепочке от точного к общему — см. lib/seo/scope.ts.
model StaticPageSeo {
  id          String   @id @default(cuid())
  path        String
  scope       String   @default("global")
  title       String?
  description String?
  noindex     Boolean  @default(false)
  body        String? // markdown-контент страницы (только offer/privacy)
  updatedAt   DateTime @updatedAt

  @@unique([path, scope])
  @@index([path])
}

/// 301/308-редиректы (сохранение позиций при смене slug курса фабрикой и т.п.).
/// from — относительный путь ("/courses/old-slug"), уникален. Резолвится в приложении
/// (courses/[slug] через permanentRedirect) — не в edge-middleware, где нет Prisma.
model Redirect {
  id        String   @id @default(cuid())
  from      String   @unique // относительный путь-источник, с ведущим /
  to        String // назначение (относительный путь или абсолютный URL)
  hits      Int      @default(0) // сколько раз сработал — в дайджест владельцу
  createdAt DateTime @default(now())

  @@index([from])
}

/// Журнал 404 на публичных страницах (агрегат по пути, не по хиту — от роста таблицы
/// при сканах ботов). По нему владелец видит битые входящие ссылки и создаёт редиректы
/// (admin/seo/redirects). Запись пути прекращается после создания редиректа.
model NotFoundHit {
  id          String   @id @default(cuid())
  path        String   @unique
  hits        Int      @default(1)
  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @updatedAt

  @@index([lastSeenAt])
}
