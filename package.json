{
  "name": "salesacademy",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "node scripts/copy-pdf-worker.mjs && next dev",
    "build": "node scripts/copy-pdf-worker.mjs && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "db:generate": "prisma generate",
    "factory:video": "tsx --env-file=.env scripts/factory/video.ts",
    "factory:audio": "tsx --env-file=.env scripts/factory/audio.ts",
    "factory:podcast": "tsx --env-file=.env scripts/factory/podcast.ts",
    "factory:slides-pdf": "tsx --env-file=.env scripts/factory/slides-pdf.ts",
    "factory:handout": "tsx scripts/factory/handout-pdf.ts",
    "factory:transcript-export": "tsx --env-file=.env scripts/factory/transcript-export.ts",
    "factory:slides-import": "tsx --env-file=.env --env-file-if-exists=.env.deploy scripts/factory/slides-import.ts",
    "factory:transcript": "tsx --env-file=.env scripts/factory/transcript.ts",
    "factory:subs": "tsx --env-file=.env scripts/factory/subs.ts",
    "factory:subs-import": "tsx --env-file=.env scripts/factory/subs-import.ts",
    "factory:chunk": "tsx --env-file=.env scripts/factory/chunk.ts",
    "factory:embed": "tsx --env-file=.env scripts/factory/embed.ts",
    "factory:publish": "tsx --env-file=.env --env-file-if-exists=.env.deploy scripts/factory/publish.ts",
    "factory:publish-video": "tsx --env-file=.env --env-file-if-exists=.env.deploy scripts/factory/publish-video.ts",
    "worker": "tsx --env-file=.env scripts/worker.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "esbuild",
      "sharp",
      "unrs-resolver"
    ]
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.104.1",
    "@node-rs/argon2": "^2.0.2",
    "@pdf-lib/fontkit": "^1.1.1",
    "@prisma/client": "^6.19.3",
    "@radix-ui/react-popover": "^1.1.21",
    "canvas-confetti": "^1.9.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "exceljs": "^4.4.0",
    "framer-motion": "^12.40.0",
    "geoip-lite": "^2.0.3",
    "hls.js": "^1.6.16",
    "lucide-react": "^0.469.0",
    "next": "^15.1.6",
    "next-auth": "5.0.0-beta.31",
    "node-cron": "^4.2.1",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.10.38",
    "pino": "^9.6.0",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "recharts": "^3.10.0",
    "tailwind-merge": "^2.6.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@playwright/test": "^1.49.1",
    "@tailwindcss/postcss": "^4.0.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/canvas-confetti": "^1.9.0",
    "@types/geoip-lite": "^1.4.4",
    "@types/node": "^22.10.5",
    "@types/node-cron": "^3.0.11",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.18.0",
    "eslint-config-next": "^15.1.6",
    "jsdom": "^25.0.1",
    "pino-pretty": "^13.0.0",
    "postcss": "^8.5.1",
    "prisma": "^6.19.3",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
