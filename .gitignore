!/public/landing/*.mp4

# misc
.DS_Store
*.log
.idea/
.vscode/

# playwright-mcp артефакты (скриншоты/трейсы при ручной проверке)
.playwright-mcp/

# pdfjs worker — копируется в public/ скриптом copy-pdf-worker (dev/build)
/public/pdf.worker.min.mjs

# Материалы курсов (исходники контента) — тяжёлые бинарники не в git.
# Транскрипты (transcript.txt) трекаются как текстовый источник.
Презентации/**/*.pptx
Презентации/**/*.pdf
Презентации/**/*.html
Презентации/**/*.webp
Презентации/**/*.docx
